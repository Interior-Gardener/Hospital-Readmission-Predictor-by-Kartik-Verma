# MongoDB Configuration
# Copy this file to .env and update with your MongoDB connection details

# MongoDB Connection String
# For local MongoDB: mongodb://localhost:27017/
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/

# Database Name
DATABASE_NAME=hospital_readmission_db

# Notes:
# 1. If using MongoDB Atlas, replace <username>, <password>, and <cluster> with your actual values
# 2. Make sure to add .env to your .gitignore file to keep credentials secure
# 3. Install MongoDB locally or use MongoDB Atlas cloud service
