
import os
DATA_PATH = "diabetic_data.csv"
if not os.path.exists(DATA_PATH):
    print("Warning: '{}' not found in working directory.".format(DATA_PATH))
    print("Either upload diabetic_data.csv using the Files panel, or use the Kaggle API to download it (see previous cell).")
else:
    print("Found dataset:", DATA_PATH)

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
import joblib
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import LabelEncoder, KBinsDiscretizer
from sklearn.metrics import accuracy_score, classification_report, roc_auc_score
from pgmpy.models import BayesianModel
from pgmpy.estimators import HillClimbSearch, BicScore, BayesianEstimator
from pgmpy.inference import VariableElimination

# Notebook constants (change as needed)
TARGET = "readmitted_bin"
NUM_BINS = 4  # number of bins for discretizing numeric features
RANDOM_STATE = 42
print("Loading dataset from:", DATA_PATH)
df = pd.read_csv(DATA_PATH)
print("Shape:", df.shape)
df.head()
print("Target 'readmitted' value counts:")
print(df['readmitted'].value_counts())

plt.figure(figsize=(6,4))
sns.countplot(x='readmitted', data=df)
plt.title('Readmitted counts')
plt.show()
for c in ['encounter_id', 'patient_nbr']:
    if c in df.columns:
        df = df.drop(columns=[c])

# Binary target: any readmission != 'NO' is considered 1
df[TARGET] = (df['readmitted'] != 'NO').astype(int)

# Select a manageable subset of features for the Bayesian Network
FEATURES_TO_USE = [
    'race', 'gender', 'age', 'diag_1', 'diag_2', 'diag_3',
    'time_in_hospital', 'num_lab_procedures', 'num_medications',
    'number_outpatient', 'number_emergency', 'number_inpatient',
    'max_glu_serum', 'A1Cresult', 'metformin', 'insulin'
]
FEATURES_TO_USE = [f for f in FEATURES_TO_USE if f in df.columns]
print("Using features:", FEATURES_TO_USE)

data = df[FEATURES_TO_USE + [TARGET]].copy()

# Simple missing handling
for col in data.columns:
    if data[col].dtype == 'O':
        data[col] = data[col].fillna('Missing')
    else:
        data[col] = data[col].fillna(data[col].median())

# Discretize numeric features (except target)
numeric_cols = data.select_dtypes(include=[np.number]).columns.tolist()
numeric_cols = [c for c in numeric_cols if c != TARGET]
if numeric_cols:
    kb = KBinsDiscretizer(n_bins=NUM_BINS, encode='ordinal', strategy='quantile')
    data[numeric_cols] = kb.fit_transform(data[numeric_cols])
    data[numeric_cols] = data[numeric_cols].astype(int)

# Encode categorical features to integer labels (pgmpy requires discrete integer states)
cat_cols = data.select_dtypes(include=['object', 'category']).columns.tolist()
encoders = {}
for col in cat_cols:
    le = LabelEncoder()
    data[col] = le.fit_transform(data[col].astype(str))
    encoders[col] = le

print("Processed data shape:", data.shape)
data.head()
train_df, test_df = train_test_split(data, test_size=0.2, random_state=RANDOM_STATE, stratify=data[TARGET])
print("Train:", train_df.shape, "Test:", test_df.shape)
print("Running structure learning (HillClimbSearch) -- this can take some time depending on data size and max_indegree.")
hc = HillClimbSearch(train_df, scoring_method=BicScore(train_df))
best_model = hc.estimate(max_indegree=3, max_iter=200)
print("Learned edges count:", len(list(best_model.edges())))
print("Sample edges:", list(best_model.edges())[:20])
model = BayesianModel(best_model.edges())
print("Fitting CPDs via BayesianEstimator...")
model.fit(train_df, estimator=BayesianEstimator, prior_type='BDeu', equivalent_sample_size=10)
print("Number of CPDs learned:", len(model.get_cpds()))
# Optional: print first few CPDs
for i, cpd in enumerate(model.get_cpds()[:3]):
    print(cpd)

X_test = test_df.drop(columns=[TARGET]).reset_index(drop=True)
y_test = test_df[TARGET].reset_index(drop=True)

# pgmpy.predict expects a DataFrame with the model variables (except target can be absent)
cols_in_model = list(model.nodes())
# If some nodes are not in X_test (unlikely), restrict to intersection
cols_for_pred = [c for c in cols_in_model if c in X_test.columns]
X_for_pred = X_test[cols_for_pred].copy()

# Try direct model.predict (fast) — may predict all variables; extract TARGET if present
try:
    y_pred_df = model.predict(X_for_pred)
    if TARGET in y_pred_df.columns:
        y_pred = y_pred_df[TARGET].astype(int)
    else:
        # fallback to MAP inference for target
        raise Exception("Target not in predicted DataFrame")
except Exception as e:
    print("model.predict didn't return target directly (or failed). Falling back to MAP queries via VariableElimination.")
    infer = VariableElimination(model)
    y_pred = []
    # iterate rows (can be slow if test set is large)
    for idx, row in X_for_pred.iterrows():
        evidence = row.to_dict()
        try:
            q = infer.map_query(variables=[TARGET], evidence=evidence)
            y_pred.append(int(q[TARGET]))
        except Exception as ex:
            # If inference fails (missing state combos), fall back to majority class
            y_pred.append(int(y_test.mode()[0]))
    y_pred = pd.Series(y_pred)

# Evaluate
print("Accuracy:", accuracy_score(y_test, y_pred))
print("\nClassification report:\n", classification_report(y_test, y_pred))

# Try probability estimates for ROC AUC
try:
    infer = VariableElimination(model)
    probs = []
    for idx, row in X_for_pred.iterrows():
        evidence = row.to_dict()
        dist = infer.query(variables=[TARGET], evidence=evidence)
        # dist.values returns array of probabilities for each state in order of state names
        # Our states are integers 0..N-1; try to pick probability of state '1' if present
        if len(dist.values) > 1:
            # assume state index 1 corresponds to readmitted=1 (binary)
            probs.append(float(dist.values[1]))
        else:
            probs.append(float(dist.values[0]))
    auc = roc_auc_score(y_test, probs)
    print("ROC AUC:", auc)
except Exception as e:
    print("Could not compute probabilities / AUC due to inference error:", e)
import joblib
joblib.dump(model, "bayesian_readmission_model.joblib")
joblib.dump(encoders, "encoders.joblib")
print("Saved bayesian_readmission_model.joblib and encoders.joblib to current working directory.")

